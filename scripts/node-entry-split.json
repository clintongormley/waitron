        "CLOCK_WAIT_REASONS",
        "CLOCK_LOOK_MS",
        "DEFAULT_EXIT",
        "paramsLine",
        "failureDetail",
        "pageLog",
        "argumentsRefused",
        "releaseSpareToStart",
        "runEntry",
        "serveStartClockWaiting",
        "clockWaitReason",
        "waitForClockReason",
        "recordedCodes",
        "recordedStartFailureCode",
        "runAdmittedEntry",
        "recordRefusal",
        "bootThisProcess"
      ]
    }
  ]
}

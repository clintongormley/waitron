{
  "tsconfig": "apps/server/tsconfig.json",
  "moves": [
    {
      "source": "apps/server/src/node-entry.ts",
      "targets": {
        "apps/server/src/node-entry-deps.ts": ["EntryDeps", "StartedEntryServer"],
        "apps/server/src/node-entry-recovery-state.ts": [
          "changeState",
          "persistState",
          "CountCheck",
          "countWritable"
        ]
      },
      "keep": [

{
  "name": "@waitron/setup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:emergency": "vite build --mode emergency && node -e \"require('node:fs').renameSync('emergency/dist/emergency.html','emergency/dist/index.html')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@waitron/diagnostics": "workspace:*",
    "@waitron/country": "workspace:*",
    "@waitron/country-packs": "workspace:*",
    "@waitron/recovery-pack": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/ui": "workspace:*",
    "lit": "^3.2.0",
    "@waitron/dashboard-modules": "workspace:*",
    "@waitron/module": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.1",
    "pdf-lib": "1.17.1",
    "playwright": "^1.65.1",
    "typescript": "^7.0.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}

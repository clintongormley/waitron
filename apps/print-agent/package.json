{
  "name": "@waitron/print-agent-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/bin.ts",
  "waitron": {
    "commands": {
      "waitron-print-agent": "./dist/print-agent.js"
    }
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/print-agent.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@waitron/print-agent": "workspace:*",
    "hono": "^4.6.0",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.25.0",
    "node-forge": "^1.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

{
  "name": "@waitron/print-agent-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tcp-probe.js": "./src/tcp-probe.ts"
  },
  "waitron": {
    "commands": {
      "waitron-print-agent": "./dist/print-agent.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/bundle-node.mjs src/bin.ts=dist/print-agent.js",
    "dev": "tsx src/dev-bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@waitron/print-agent": "workspace:*",
    "hono": "^4.13.8",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/node-forge": "^1.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "node-forge": "^1.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}

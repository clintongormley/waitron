# Committed TEMPLATE documenting apps/server's dev env contract. The real `apps/server/.env` is
# GENERATED by `pnpm dev:setup` and gitignored — do not edit it by hand; regenerate with
# `pnpm dev:reset`. This file is only here to document each variable.
#
# `trading.env` carries NO storage setting. The venue directory is resolved from the state root the
# same way on both sides of the restart (`WAITRON_VENUE_DIR` below, else `<stateDir>/venue`), so
# setup and trading open one directory without either file naming it twice.

# The directory holding this venue's two database files (`venue.db` and `node.db`). Unset means
# `<WAITRON_STATE_DIR>/venue`, which is what `pnpm dev:setup` provisions into and what the server
# then opens. Throwaway PREPRODUCTION data only in dev — never point this at a real venue.
# WAITRON_VENUE_DIR=/var/lib/waitron/venue

# Deployment environment. Dev is ALWAYS preproduction — it never files a real AEAT record. Typing
# out `production` here against this throwaway database is exactly the mistake WAITRON_ENV guards.
WAITRON_ENV=preproduction

# The server port. A fresh demo uses HTTP; preserved box TLS state makes it HTTPS. The Vite
# dev servers inspect the same state and proxy their API and media routes with the matching protocol.
WAITRON_HTTP_PORT=8080

# WAITRON_STATE_DIR is where the box persists its self-signed cert, generated secrets.env, and (once
# provisioned) trading.env — see the ONBOARDING note above; unset uses a local default. Set
# WAITRON_TLS_CERT_FILE / WAITRON_TLS_KEY_FILE (both or neither) to override the self-signed cert
# with your own — the box still generates its secrets.
# WAITRON_STATE_DIR=/var/lib/waitron
# WAITRON_TLS_CERT_FILE=/etc/waitron/tls/cert.pem
# WAITRON_TLS_KEY_FILE=/etc/waitron/tls/key.pem

# Dashboard passkeys and emailed account links use this public identity. Production requires both.
# WAITRON_MANAGEMENT_RP_ID=dashboard.example.com
# WAITRON_MANAGEMENT_ORIGIN=https://dashboard.example.com

# Google login is optional. Register this exact callback with the Google OAuth client:
# <WAITRON_MANAGEMENT_ORIGIN>/management-api/google/callback
# Set both values or neither; a partial configuration stops the server at boot.
# WAITRON_GOOGLE_CLIENT_ID=<oauth-client-id>
# WAITRON_GOOGLE_CLIENT_SECRET=<oauth-client-secret>

# Outside WAITRON_ENV=dev, a box listening on a non-loopback host advertises `waitron.local`
# over mDNS in setup and trading modes. In setup mode it also serves its CA at `/setup-api/ca.crt`
# plus a trust page at `/setup/trust`. Trusting that CA
# once gets a device a warning-free HTTPS/PWA experience thereafter (spec §3). No new env var — this
# is the existing WAITRON_STATE_DIR-backed CA/leaf, just discoverable and downloadable now.

# Credentials-encryption key: 32 random bytes, base64, plus its version. `dev:setup` generates a
# fresh key each time it provisions.
WAITRON_CREDENTIALS_KEY=<base64-encoded-32-bytes>
WAITRON_CREDENTIALS_KEY_VERSION=1

# Node stamped by provisioning. Boot reads its location from the database; invoice issuance reads the live series.
WAITRON_NODE_ID=<uuid>

# Optional Cloud portal origin. HTTPS required, except loopback HTTP with WAITRON_ENV=dev.
# WAITRON_CLOUD_ORIGIN=https://cloud.example.com

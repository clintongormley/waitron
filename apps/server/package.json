{
  "name": "@waitron/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/bin.ts",
  "waitron": {
    "commands": {
      "waitron-server": "./dist/server.js",
      "waitron-recovery": "./dist/bin-recovery.js",
      "waitron-break-glass": "./dist/bin-break-glass.js",
      "waitron-restore": "./dist/bin-restore.js",
      "waitron-rejoin": "./dist/bin-rejoin.js"
    }
  },
  "scripts": {
    "build": "node scripts/copy-migrations.mjs && node ../../scripts/bundle-node.mjs src/bin.ts=dist/server.js scripts/record-one-sale.ts=dist/record-one-sale.js scripts/register-till.ts=dist/register-till.js scripts/settle-invoice-first.ts=dist/settle-invoice-first.js src/bin-recovery.ts=dist/bin-recovery.js src/bin-break-glass.ts=dist/bin-break-glass.js src/bin-restore.ts=dist/bin-restore.js src/bin-rejoin.ts=dist/bin-rejoin.js src/node-entry.ts=dist/node-entry.js",
    "dev": "node scripts/dev-server.mjs",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "dev:reset": "tsx scripts/dev-setup.ts --reset",
    "dev:onboard": "tsx scripts/dev-onboard.ts",
    "dev:reset:onboard": "tsx scripts/dev-onboard.ts --reset",
    "test": "vitest run",
    "test:preprod": "vitest run --config vitest.preprod.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --coverage --reporter=default --reporter=blob --coverage.thresholds.statements=0 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0",
    "test:merge": "vitest --merge-reports .vitest-reports --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "demo:daily-close": "tsx scripts/daily-close-demo.ts",
    "demo:daily-close-z": "tsx scripts/daily-close-z-demo.ts",
    "demo:modelo-303": "tsx scripts/modelo-303-demo.ts",
    "demo:allergens": "tsx scripts/allergens-demo.ts",
    "demo:recipes": "tsx scripts/recipes-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@hono/node-server": "^2.1.1",
    "@waitron/bookings": "workspace:*",
    "@waitron/catalogue": "workspace:*",
    "@waitron/composition": "workspace:*",
    "@waitron/core": "workspace:*",
    "@waitron/country": "workspace:*",
    "@waitron/country-packs": "workspace:*",
    "@waitron/credentials": "workspace:*",
    "@waitron/db": "workspace:*",
    "@waitron/fiscal": "workspace:*",
    "@waitron/fiscal-verifactu": "workspace:*",
    "@waitron/identity": "workspace:*",
    "@waitron/layouts": "workspace:*",
    "@waitron/media": "workspace:*",
    "@waitron/membership": "workspace:*",
    "@waitron/migrations": "workspace:*",
    "@waitron/module": "workspace:*",
    "@waitron/payments": "workspace:*",
    "@waitron/payments-stripe": "workspace:*",
    "@waitron/payments-sumup": "workspace:*",
    "@waitron/printing": "workspace:*",
    "@waitron/provisioning": "workspace:*",
    "@waitron/purchasing": "workspace:*",
    "@waitron/recipes": "workspace:*",
    "@waitron/reporting": "workspace:*",
    "@waitron/scheduler": "workspace:*",
    "@waitron/server-kit": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/stream": "workspace:*",
    "@waitron/sync-enrolment": "workspace:*",
    "@waitron/tunnel": "workspace:*",
    "@waitron/venue-service": "workspace:*",
    "@waitron/workforce": "workspace:*",
    "@waitron/workforce-es": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "jose": "^6.1.0",
    "multicast-dns": "^7.2.5",
    "node-forge": "^1.3.1",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "stripe": "^22.6.2",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@simplewebauthn/server": "^14.0.0",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.0.0",
    "@types/node-forge": "^1.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@waitron/print-agent": "workspace:*",
    "@waitron/print-agent-app": "workspace:*",
    "@waitron/verifactu": "^0.1.0",
    "esbuild": "^0.28.2",
    "otplib": "^13.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}

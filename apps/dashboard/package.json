{
  "name": "@waitron/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --coverage --reporter=default --reporter=blob --coverage.thresholds.statements=0 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0",
    "test:merge": "vitest --merge-reports .vitest-reports --coverage --coverage.provider=custom --coverage.customProviderModule=../../scripts/vitest-shard-coverage-merge.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@waitron/catalogue": "workspace:^",
    "@waitron/dashboard-kit": "workspace:*",
    "@waitron/dashboard-modules": "workspace:*",
    "@waitron/diagnostics": "workspace:*",
    "@waitron/printing": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/ui": "workspace:*",
    "@waitron/venue-service": "workspace:*",
    "lit": "^3.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@waitron/layouts": "workspace:*",
    "axe-core": "^4.13.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}

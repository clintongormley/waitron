{
  "name": "waitron",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:setup": "docker compose up -d db && pnpm --filter @waitron/server dev:setup",
    "dev:reset": "docker compose down -v && docker compose up -d db && pnpm --filter @waitron/server dev:reset",
    "test": "vitest run && pnpm -r test",
    "test:coverage": "vitest run --coverage && pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.0.0"
  }
}

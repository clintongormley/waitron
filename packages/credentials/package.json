{
  "name": "@waitron/credentials",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "waitron": {
    "commands": {
      "waitron-credentials": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/bundle-node.mjs src/bin.ts=dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@waitron/db": "workspace:*",
    "@waitron/membership": "workspace:*",
    "@waitron/node-db": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/store": "workspace:*",
    "@waitron/sync-enrolment": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.0",
    "vitest": "^4.1.12"
  }
}

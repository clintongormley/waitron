{
  "name": "@waitron/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing/lifecycle.js": "./src/testing/lifecycle.ts",
    "./testing/postgres.js": "./src/testing/postgres.ts",
    "./testing/seed.js": "./src/testing/seed.ts",
    "./testing/shared-container.js": "./src/testing/shared-container.ts",
    "./testing/two-node.js": "./src/testing/two-node.ts",
    "./testing/two-node-wireguard.js": "./src/testing/two-node-wireguard.ts",
    "./testing/venue-db.js": "./src/testing/venue-db.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --coverage --reporter=default --reporter=blob --coverage.thresholds.statements=0 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0",
    "test:merge": "vitest --merge-reports .vitest-reports --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@waitron/membership": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/sync-enrolment": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}

{
  "name": "@waitron/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema/adjustments.js": "./src/schema/adjustments/index.ts",
    "./schema/menu.js": "./src/schema/menu/index.ts",
    "./schema/credentials.js": "./src/schema/credentials/index.ts",
    "./schema/handover.js": "./src/schema/handover/index.ts",
    "./schema/identity.js": "./src/schema/identity/index.ts",
    "./schema/media.js": "./src/schema/media/index.ts",
    "./schema/venue-service.js": "./src/schema/venue-service/index.ts",
    "./testing/schema-conformance.js": "./src/testing/schema-conformance.ts",
    "./testing/seed.js": "./src/testing/seed.ts",
    "./testing/venue-db.js": "./src/testing/venue-db.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --coverage --reporter=default --reporter=blob --coverage.thresholds.statements=0 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0",
    "test:merge": "vitest --merge-reports .vitest-reports --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "mutation": "stryker run",
    "db:generate": "pnpm --filter @waitron/server migration-baseline rebuild --set core"
  },
  "dependencies": {
    "@waitron/membership": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/store": "workspace:*",
    "@waitron/sync-enrolment": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.0",
    "vitest": "^4.1.12"
  }
}

{
  "name": "@waitron/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing/schema-conformance.js": "./src/testing/schema-conformance.ts",
    "./testing/seed.js": "./src/testing/seed.ts",
    "./testing/venue-db.js": "./src/testing/venue-db.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --coverage --reporter=default --reporter=blob --coverage.thresholds.statements=0 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0",
    "test:merge": "vitest --merge-reports .vitest-reports --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "@waitron/membership": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/store": "workspace:*",
    "@waitron/sync-enrolment": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}

        "time_entries_recorded_at_second_ck": {
          "name": "time_entries_recorded_at_second_ck",
          "value": "\"time_entries\".\"recorded_at\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9].000Z'"
        },
        "time_entries_entry_kind_ck": {
          "name": "time_entries_entry_kind_ck",
          "value": "\"time_entries\".\"entry_kind\" in ('in', 'out', 'break_start', 'break_end', 'correction')"
        },

        "time_entries_event_offset_ck": {
          "name": "time_entries_event_offset_ck",
          "value": "\"time_entries\".\"event_offset_minutes\" between -840 and 840"
        },
        "time_entries_correction_shape_ck": {
          "name": "time_entries_correction_shape_ck",
          "value": "(\"time_entries\".\"corrects_entry_id\" is null and \"time_entries\".\"correction_reason\" is null\n             and \"time_entries\".\"correction_status\" is null and \"time_entries\".\"correction_actor_id\" is null)\n          or (\"time_entries\".\"corrects_entry_id\" is not null and \"time_entries\".\"correction_reason\" is not null\n             and \"time_entries\".\"correction_status\" is not null and \"time_entries\".\"correction_actor_id\" is not null)"
        },
        "time_entries_entry_hash_ck": {
          "name": "time_entries_entry_hash_ck",
          "value": "length(\"time_entries\".\"entry_hash\") = 64 and \"time_entries\".\"entry_hash\" not glob '*[^0-9A-F]*'"
        },
        "time_entries_sequence_no_ck": {
          "name": "time_entries_sequence_no_ck",
          "value": "\"time_entries\".\"sequence_no\" > 0"
        },
        "time_entries_chaining_ck": {
          "name": "time_entries_chaining_ck",
          "value": "(\"time_entries\".\"is_first_entry\" and \"time_entries\".\"prev_entry_hash\" is null)\n          or (not \"time_entries\".\"is_first_entry\" and \"time_entries\".\"prev_entry_hash\" is not null)"
        },
        "time_entries_event_at_second_ck": {
          "name": "time_entries_event_at_second_ck",
          "value": "\"time_entries\".\"event_at\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9].000Z'"

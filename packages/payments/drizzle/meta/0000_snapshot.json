      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "payments_resolution_outcome_ck": {
          "name": "payments_resolution_outcome_ck",
          "value": "\"payments\".\"resolution_outcome\" in ('captured', 'failed')"
        },
        "payments_resolution_cancelled_ck": {
          "name": "payments_resolution_cancelled_ck",
          "value": "\"payments\".\"resolution_cancelled_at_provider\" is null or \"payments\".\"resolution_cancelled_at_provider\" = 0 or \"payments\".\"resolution_outcome\" = 'failed'"
        },
        "payments_resolution_fields_ck": {
          "name": "payments_resolution_fields_ck",
          "value": "(\"payments\".\"resolution_outcome\" is null) = (\"payments\".\"resolved_at\" is null) and (\"payments\".\"resolution_outcome\" is null) = (\"payments\".\"resolution_cancelled_at_provider\" is null) and (\"payments\".\"resolution_outcome\" is not null or (\"payments\".\"resolution_provider_status\" is null and \"payments\".\"resolved_by\" is null))"
        },
        "payments_hold_amount_ck": {
          "name": "payments_hold_amount_ck",
          "value": "\"payments\".\"hold_provider_amount\" is null or \"payments\".\"hold_provider_amount\" > 0"
        },
        "payments_hold_fields_ck": {
          "name": "payments_hold_fields_ck",
          "value": "(\"payments\".\"hold_provider_amount\" is null) = (\"payments\".\"held_at\" is null)"
        },
        "payments_hold_outcome_ck": {
          "name": "payments_hold_outcome_ck",
          "value": "\"payments\".\"hold_outcome\" in ('refunded_at_provider', 'kept')"
        },
        "payments_hold_note_ck": {
          "name": "payments_hold_note_ck",
          "value": "\"payments\".\"hold_note\" is null or length(trim(\"payments\".\"hold_note\")) > 0"
        },
        "payments_hold_outcome_fields_ck": {
          "name": "payments_hold_outcome_fields_ck",
          "value": "(\"payments\".\"hold_outcome\" is null) = (\"payments\".\"hold_decided_by\" is null) and (\"payments\".\"hold_outcome\" is null) = (\"payments\".\"hold_decided_at\" is null) and (\"payments\".\"hold_outcome\" is null or \"payments\".\"held_at\" is not null) and (\"payments\".\"hold_outcome\" is not null or \"payments\".\"hold_note\" is null)"
        },
        "payments_hold_or_remediation_ck": {
          "name": "payments_hold_or_remediation_ck",
          "value": "\"payments\".\"held_at\" is null or \"payments\".\"reconcile_remediated_at\" is null"
        },
        "payments_amount_ck": {
          "name": "payments_amount_ck",
          "value": "\"payments\".\"amount\" > 0"
        },
        "payments_card_last4_ck": {
          "name": "payments_card_last4_ck",
          "value": "\"payments\".\"card_last4\" is null or length(\"payments\".\"card_last4\") = 4"
        },
        "payments_card_entry_mode_ck": {
          "name": "payments_card_entry_mode_ck",
          "value": "\"payments\".\"card_entry_mode\" is null or \"payments\".\"card_entry_mode\" in ('contactless','chip','swipe','unknown')"
        },
        "payments_state_ck": {
          "name": "payments_state_ck",
          "value": "\"payments\".\"state\" in ('attempting', 'captured', 'voided', 'refunded', 'partially_refunded', 'failed', 'initiated')"
        },
        "payments_external_provider_ck": {
          "name": "payments_external_provider_ck",
          "value": "\"payments\".\"external_provider\" in ('connected_account', 'other')"
        },
        "payments_source_ck": {
          "name": "payments_source_ck",
          "value": "\"payments\".\"source\" in ('device', 'demo_seed', 'readiness_test', 'operator_script', 'trading_day_close')"
        },
        "payments_source_device_ck": {
          "name": "payments_source_device_ck",
          "value": "(\"payments\".\"source\" = 'device') = (\"payments\".\"device_id\" is not null)"
        }
      }
    },

{
  "name": "@waitron/fiscal-verifactu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "waitron": {
    "commands": {
      "waitron-paper-custodian": "./dist/paper-custodian.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/bundle-node.mjs src/paper-custodian-bin.ts=dist/paper-custodian.js && pnpm build:custodian",
    "test": "pnpm build:custodian && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm build:custodian && vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "build:custodian": "node scripts/build-custodian.mjs"
  },
  "dependencies": {
    "@waitron/core": "workspace:*",
    "@waitron/credentials": "workspace:*",
    "@waitron/dashboard-kit": "workspace:*",
    "@waitron/db": "workspace:*",
    "@waitron/fiscal": "workspace:*",
    "@waitron/module": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/sync-enrolment": "workspace:*",
    "@waitron/ui": "workspace:*",
    "@waitron/verifactu": "^0.2.1",
    "drizzle-orm": "^0.45.4",
    "lit": "^3.2.0",
    "undici": "^8.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/node-forge": "^1.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@waitron/catalogue": "workspace:*",
    "@waitron/country-packs": "workspace:*",
    "@waitron/identity": "workspace:*",
    "@waitron/migrations": "workspace:*",
    "@waitron/server-kit": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "node-forge": "^1.3.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11",
    "axe-core": "^4.13.0",
    "vite": "^8.3.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./paper-protocol": "./src/paper-protocol.ts",
    "./paper-register-history": "./src/paper-register-history.ts",
    "./paper-register-protocol": "./src/paper-register-protocol.ts",
    "./paper-register-compact": "./src/paper-register-compact.ts",
    "./register-protocol": "./src/register-protocol.ts",
    "./register-history": "./src/register-history.ts",
    "./register-compact": "./src/custodian/register-compact.ts",
    "./custodian": "./src/custodian/index.ts",
    "./src/*": "./src/*",
    "./test/*": "./test/*",
    "./package.json": "./package.json",
    "./setup": "./src/setup/first-fiscal-screen.ts"
  }
}

{
  "name": "@waitron/fiscal-verifactu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "waitron": {
    "commands": {
      "waitron-paper-custodian": "./dist/paper-custodian.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/bundle-node.mjs src/paper-custodian-bin.ts=dist/paper-custodian.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "@waitron/core": "workspace:*",
    "@waitron/credentials": "workspace:*",
    "@waitron/db": "workspace:*",
    "@waitron/fiscal": "workspace:*",
    "@waitron/module": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/sync-enrolment": "workspace:*",
    "@waitron/verifactu": "^0.2.1",
    "drizzle-orm": "^0.45.4",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@waitron/catalogue": "workspace:*",
    "@waitron/country-packs": "workspace:*",
    "@waitron/identity": "workspace:*",
    "@waitron/migrations": "workspace:*",
    "@waitron/server-kit": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.0",
    "vitest": "^5.0.4"
  }
}

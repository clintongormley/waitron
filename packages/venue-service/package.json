{
  "name": "@waitron/venue-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dashboard": "./src/dashboard/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",

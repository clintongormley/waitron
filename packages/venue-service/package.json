{
  "name": "@waitron/venue-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routing": "./src/routing.ts",
    "./hours-types": "./src/hours-types.ts",
    "./holiday-types": "./src/holiday-types.ts",
    "./testing/station-week.js": "./src/testing/station-week.ts",
    "./testing/zone-menus.js": "./src/testing/zone-menus.ts",
    "./dashboard": "./src/dashboard/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --coverage --reporter=default --reporter=blob --coverage.thresholds.statements=0 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0",
    "test:merge": "vitest --merge-reports .vitest-reports --coverage --coverage.provider=custom --coverage.customProviderModule=../../scripts/vitest-shard-coverage-merge.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "@waitron/catalogue": "workspace:*",
    "@waitron/country": "workspace:*",
    "@waitron/country-packs": "workspace:*",
    "@waitron/db": "workspace:*",
    "@waitron/dashboard-kit": "workspace:*",
    "@waitron/identity": "workspace:*",
    "@waitron/migrations": "workspace:*",
    "@waitron/module": "workspace:*",
    "@waitron/reporting": "workspace:*",
    "@waitron/shared": "workspace:*",
    "@waitron/server-kit": "workspace:*",
    "@waitron/sync-enrolment": "workspace:*",
    "@waitron/ui": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}

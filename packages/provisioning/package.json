{
  "name": "@waitron/provisioning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "waitron": {
    "commands": {
      "waitron-provision": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/bin.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@waitron/composition": "workspace:*",
    "@waitron/country-packs": "workspace:*",
    "@waitron/db": "workspace:*",
    "@waitron/fiscal": "workspace:*",
    "@waitron/identity": "workspace:*",
    "@waitron/layouts": "workspace:*",
    "@waitron/migrations": "workspace:*",
    "@waitron/module": "workspace:*",
    "@waitron/shared": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@waitron/core": "workspace:*",
    "@waitron/fiscal-verifactu": "workspace:*",
    "@waitron/verifactu": "^0.1.0",
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}

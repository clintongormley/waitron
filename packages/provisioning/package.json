{
  "name": "@waitron/provisioning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "waitron-provision": "./dist/bin.js"
  },
  "scripts": {
    "build": "node scripts/copy-migrations.mjs && esbuild src/bin.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/bin.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@waitron/composition": "workspace:*",
    "@waitron/db": "workspace:*",
    "@waitron/fiscal": "workspace:*",
    "@waitron/identity": "workspace:*",
    "@waitron/layouts": "workspace:*",
    "@waitron/migrations": "workspace:*",
    "@waitron/module": "workspace:*",
    "@waitron/shared": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@waitron/core": "workspace:*",
    "@waitron/fiscal-verifactu": "workspace:*",
    "@waitron/verifactu": "workspace:*",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

        "adjustments_action_ck": {
          "name": "adjustments_action_ck",
          "value": "\"adjustments\".\"action\" in ('cancel', 'comp', 'discount_percent', 'discount_amount')"
        },
        "adjustments_stage_ck": {
          "name": "adjustments_stage_ck",
          "value": "\"adjustments\".\"stage\" in ('unsent', 'held', 'fired', 'served')"
        },
        "adjustments_reason_name_ck": {
          "name": "adjustments_reason_name_ck",
          "value": "length(trim(\"adjustments\".\"reason_name\")) > 0"
        },
        "adjustments_amounts_ck": {
          "name": "adjustments_amounts_ck",
          "value": "\"adjustments\".\"after_amount\" >= 0 and \"adjustments\".\"after_amount\" <= \"adjustments\".\"before_amount\"\n          and \"adjustments\".\"reduction\" = \"adjustments\".\"before_amount\" - \"adjustments\".\"after_amount\" and \"adjustments\".\"nominal_value\" >= 0"
        },
        "adjustments_percent_ck": {
          "name": "adjustments_percent_ck",
          "value": "(\"adjustments\".\"action\" = 'discount_percent') = (\"adjustments\".\"percent_bp\" is not null)\n          and (\"adjustments\".\"percent_bp\" is null or \"adjustments\".\"percent_bp\" between 1 and 10000)"
        },
        "adjustments_line_level_ck": {
          "name": "adjustments_line_level_ck",
          "value": "\"adjustments\".\"line_id\" is null or (\"adjustments\".\"line_name\" is not null and \"adjustments\".\"stage\" is not null\n          and \"adjustments\".\"line_quantity\" is not null and \"adjustments\".\"line_quantity\" > 0\n          and \"adjustments\".\"line_list_unit_price\" is not null and \"adjustments\".\"line_list_unit_price\" >= 0\n          and \"adjustments\".\"quantity\" is not null and \"adjustments\".\"quantity\" > 0\n          and \"adjustments\".\"quantity\" <= \"adjustments\".\"line_quantity\")"
        },
        "adjustments_bill_level_ck": {
          "name": "adjustments_bill_level_ck",
          "value": "\"adjustments\".\"line_id\" is not null or (\"adjustments\".\"line_name\" is null and \"adjustments\".\"line_quantity\" is null\n          and \"adjustments\".\"line_list_unit_price\" is null and \"adjustments\".\"credited_to\" is null and \"adjustments\".\"quantity\" is null\n          and \"adjustments\".\"stage\" is null and json_array_length(\"adjustments\".\"split_line_ids\") = 0\n          and \"adjustments\".\"action\" in ('discount_percent', 'discount_amount'))"
        }
      }

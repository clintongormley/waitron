# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Test / tooling caches
coverage/
# Pinned test and dev binaries the setup scripts download (`scripts/setup-litestream.mjs`,
# `scripts/setup-s3-test-server.mjs`).
/.bin/
.vitest/
# vitest `--reporter=blob` output — the per-shard coverage blobs the sharded CI jobs upload as
# artifacts and the merge jobs consume. Generated, never committed.
.vitest-reports/
.turbo/
__screenshots__/
# Vitest 4's attachments directory (`attachmentsDir`) — what a test hands to `context.annotate`,
# plus whatever the browser runner copies in beside it. Generated by a run, never committed.
.vitest-attachments/

# Stryker mutation testing (sandbox copies + incremental cache + HTML report)
.stryker-tmp/
reports/

# Environment
.env
.env.*
!.env.example

# Fiscal — never commit certificates or keys
*.p12
*.pfx
*.pem
*.key
certs/
# Public halves only: boxes trust these to check signed releases.
!deploy/box/release-keys/current.pem
!deploy/box/release-keys/spare.pem

# Editor / OS
.DS_Store
*.swp

# Agent scratch
.claude/worktrees/
.claude/settings.local.json
.superpowers/
docs/handoffs/

# Impeccable's working files: mock-ups are never committed (CLAUDE.md §6). Everything under
# .impeccable/ is ignored except the files Impeccable says to share.
.impeccable/*
!.impeccable/config.json
!.impeccable/design.json
!.impeccable/surfaces/
!.impeccable/live/
.impeccable/live/*
!.impeccable/live/config.json
!.impeccable/critique/
.impeccable/critique/*
!.impeccable/critique/ignore.md

# The box's self-signed cert + generated secrets, materialised on first setup boot.
# The dev default is apps/server/src/state (from-source) / apps/server/dist/state (built, already
# covered by dist/). Never commit secrets. Deployment sets WAITRON_STATE_DIR to a protected path.
apps/server/src/state/

# Product images the demo seed writes into the from-source DEFAULT_MEDIA_ROOT on `pnpm dev:setup`
# Demo seed output lives in the development media directory.
apps/server/src/media/

# A development copy of the declaration folder (`src/testing/declaration-folder.ts`).
apps/server/src/declaration/

# Generated by pnpm — reformatting this by hand risks pnpm's own parser
# rejecting a Prettier-normalized version of it.
pnpm-lock.yaml

# vitest `--reporter=blob` output — machine-written per-shard coverage blobs (see .gitignore). They
# are generated during local shard runs and in CI, never hand-edited, so they must not fail
# format:check when one is present in a working tree.
.vitest-reports/

# Prose content, not tooling's to reformat (see task constraints).
docs/

# Generated by drizzle-kit. Regenerating rewrites these files wholesale, so any
# Prettier-normalised version is lost on the next `generate` — and until then
# `format:check`, a required CI step, fails on output nobody hand-wrote.
packages/*/drizzle/

# AEAT's own published artefacts, committed verbatim. Prettier has no parser for
# .xsd or .wsdl and would skip them anyway, but a future parser addition must not
# be able to reformat a primary source.
packages/verifactu/schemas/

# AEAT's published modelo 303 record design (DR303e26.xlsx, committed verbatim as the
# provenance for src/dr303-layout.ts) plus its offline generator/README. Same rule as
# the schemas above: a primary source must never be reformatted. The GENERATED
# src/dr303-layout.ts is NOT here — it is prettier-checked like all src.
packages/reporting/reference/

# The Iosevka font's licence, committed verbatim from the font's repository at its release tag
# (deploy/third-party/iosevka/README.md). Same rule: a licence text is never reformatted.
deploy/third-party/iosevka/LICENSE.md

# BOE and INE pages, committed byte for byte: the holiday data's tests hash them against the
# SHA-256 the shipped data names (packages/country-es/src/data/sources/README.md).
packages/country-es/src/data/sources/*.htm
packages/country-es/src/data/sources/*.xml

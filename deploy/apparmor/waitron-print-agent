# Waitron's AppArmor profile for the print-agent container. Everything above the D-Bus section is
# Moby's `docker-default` template, copied from moby/profiles apparmor/template.go at
# f0494f1fbb1bbaf2e1b02ee20aab206f32456a63, and changed: the ABI line, the includes, the profile
# name, the peer name in the signal and ptrace rules, and dockerd's label are filled in, the two
# names without the quotes the template puts round them; the template's "profile generated by"
# first line is dropped, and the comment on dockerd's signal rule is extended. What a given Docker version
# generates from its own copy may differ. That template is Copyright The Moby Authors,
# licensed under the Apache License, Version 2.0 (https://www.apache.org/licenses/LICENSE-2.0; in
# the Waitron repository, deploy/third-party/licenses/Apache-2.0.txt). The D-Bus section
# at the end is Waitron's addition: `docker-default` has no D-Bus rules, so the system bus refuses
# the container's first message (`Hello`) and `bluetoothctl` cannot reach BlueZ at all.
#
# The D-Bus rules are what bluetoothctl 5.82 sends and receives for `list`, `devices Paired`,
# `scan on`, `scan off`, pairing with a PIN through its interactive agent, and `remove`; `info`
# worked under them against the stand-in, but whether it drew a refusal was not read (below).
# Each was measured against a stand-in BlueZ (scripts/fake-bluez.py) on a GitHub Ubuntu 24.04 runner
# (kernel 6.17, AppArmor parser 4.0.1, dbus-daemon 1.14.10, Docker 28.0.4), with bluetoothctl from
# the print-agent stage's own bluez package (5.82-1.1). The listing and `scan on` rules: runs
# 36562032152 and 36562581079, where `list`, `devices Paired` and `scan on` worked with
# no refusal. The pairing and `remove` rules: probe run 36585218089.
# There, with the previous rules loaded in complain mode, pairing, `remove`
# and a PIN request left unanswered logged as ALLOWED exactly the messages the new rules name. With
# each new rule dropped in turn its step failed or logged a refusal naming that message, and with
# all of them the same steps worked, refusing nothing but the broadcasts named below. Nothing had to
# be allowed for bluetoothctl's replies to BlueZ's calls: the PIN and the answer to `Cancel` both
# reached the stand-in. Probe run 36586467212 ran the same steps under these rules as written, with
# the same result, and image-smoke passed under them there. The `scan off` (`StopDiscovery`) and
# `Disconnected` rules: probe run 36617097865, without them, refused the three messages the owner's
# box refused around a real pairing (2026-09-29) — `StopDiscovery` from an interactive `scan off`,
# and `Disconnected` on `Device1` and `Bearer.BREDR1` after the stand-in's pairing — and probe run
# 36617716323, with them, refused none of them. On both, the agent's own scan
# (`bluetoothctl --timeout 6 scan on`, three times) sent no `StopDiscovery`: nothing reached the stand-in and nothing was
# refused, where an interactive `scan off` on the same runs was refused (36617097865) or reached it
# (36617716323). `info`, which the agent's scan asks of a listed device, worked under these rules:
# probe run 36629179144 asked it of the stand-in's four printers at once and each exited 0 printing
# its class and icon; that run stopped before its refusal check, so whether `info` drew any refusal
# was not read.
#
# Refused on 36585218089 and 36586467212: `trust` (a `Properties.Set`) and `Device1.Disconnect`.
# Also refused: the `InterfacesAdded` and `InterfacesRemoved` signals interactive bluetoothctl
# broadcasts about its own agent. They were refused only while another process was listening for such signals from any
# sender, and pairing still worked. `Agent1.Release`, which bluetoothd sends when it drops an agent
# itself, is not allowed: the stand-in never sends it.
#
# BlueZ's signals and its calls to the agent are allowed only from an unconfined sender, which the
# stand-in was (root, no profile). A sender cannot be matched by its well-known name:
# `peer=(name=org.bluez)` on the receive rules refused both scan signals on the A129 runs. A
# bluetoothd running under a profile of its own would not match `label=unconfined` (not tried); with
# its signals refused, `scan on` prints no `[NEW]` or `[CHG]` lines, as it did on the runner with no
# receive rules at all.
abi <abi/3.0>,
#include <tunables/global>

profile waitron-print-agent flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill"). The template fills in
  # dockerd's own label here; dockerd ran as `unconfined` on a GitHub Ubuntu 24.04 runner with
  # Docker 28.0.4 (`ps -eo pid,comm,label`, run 36558516384). A confined dockerd was not measured.
  signal (receive) peer=unconfined,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=waitron-print-agent,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer=waitron-print-agent,

  # --- Waitron: the system bus, for bluetoothctl. ---

  dbus send
       bus=system
       path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus
       member={Hello,AddMatch,RemoveMatch,GetNameOwner}
       peer=(name=org.freedesktop.DBus),

  dbus send
       bus=system
       path=/
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name=org.bluez),

  dbus send
       bus=system
       path=/org/bluez/hci*
       interface=org.bluez.Adapter1
       member={SetDiscoveryFilter,StartDiscovery,StopDiscovery}
       peer=(name=org.bluez),

  dbus receive
       bus=system
       path=/
       interface=org.freedesktop.DBus.ObjectManager
       member=InterfacesAdded
       peer=(label=unconfined),

  # A device BlueZ drops: after `remove`, and during a plain scan, where the owner's box refused it
  # under the previous rules (2026-09-29).
  dbus receive
       bus=system
       path=/
       interface=org.freedesktop.DBus.ObjectManager
       member=InterfacesRemoved
       peer=(label=unconfined),

  # Pair: interactive bluetoothctl registers its agent, so BlueZ can ask it for the PIN.
  dbus send
       bus=system
       path=/org/bluez
       interface=org.bluez.AgentManager1
       member=RegisterAgent
       peer=(name=org.bluez),

  # Pair: the pairing itself.
  dbus send
       bus=system
       path=/org/bluez/hci*/dev_*
       interface=org.bluez.Device1
       member=Pair
       peer=(name=org.bluez),

  # Pair: BlueZ asks the agent for the PIN, and cancels the question when nobody answers in time.
  # CI checks RequestPinCode (image-smoke pairs with a PIN) but not Cancel: only probe run
  # 36585218089, which left a PIN request unanswered, measured that Cancel needs this rule.
  dbus receive
       bus=system
       path=/org/bluez/agent
       interface=org.bluez.Agent1
       member={RequestPinCode,Cancel}
       peer=(label=unconfined),

  # Forget: `bluetoothctl remove`.
  dbus send
       bus=system
       path=/org/bluez/hci*
       interface=org.bluez.Adapter1
       member=RemoveDevice
       peer=(name=org.bluez),

  # A device dropping its connection, as the owner's printer did after its pairing (2026-09-29): there
  # the previous rules refused both signals to an interactive bluetoothctl that had just paired.
  dbus receive
       bus=system
       path=/org/bluez/hci*/dev_*
       interface={org.bluez.Device1,org.bluez.Bearer.BREDR1}
       member=Disconnected
       peer=(label=unconfined),

  dbus receive
       bus=system
       path=/org/bluez/**
       interface=org.freedesktop.DBus.Properties
       member=PropertiesChanged
       peer=(label=unconfined),
}

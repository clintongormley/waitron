[Unit]
Description=Waitron box: one host request from the app
CollectMode=inactive-or-failed

[Service]
EnvironmentFile=-/opt/waitron-host/service.env
ExecStart=/usr/local/lib/waitron/waitron-box.sh %i
ExecStopPost=/usr/local/lib/waitron/waitron-box.sh --restore %i
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=15

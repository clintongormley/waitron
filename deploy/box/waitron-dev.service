[Unit]
Description=Start the installed emulator-only Waitron development box
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/waitron-dev-start
RemainAfterExit=yes
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console

[Install]
WantedBy=multi-user.target

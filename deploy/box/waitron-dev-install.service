[Unit]
Description=Install the emulator-only Waitron development disk
After=local-fs.target
Requires=local-fs.target
SuccessAction=none
FailureAction=poweroff

[Service]
Type=oneshot
SuccessExitStatus=SIGTERM
ExecStart=/usr/local/sbin/waitron-dev-install
StandardOutput=tty
StandardError=tty
StandardInput=tty-force
TTYPath=/dev/ttyS0

[Unit]
Description=Observe outside network changes for the Waitron boot copy
After=NetworkManager.service waitron-disk-ready.service
Requires=NetworkManager.service
RequiresMountsFor=/var/lib/waitron-host /boot
ConditionPathExists=/etc/waitron-dev-luks
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/lib/waitron/waitron-box.sh --network-monitor
Restart=on-failure
RestartSec=1
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
